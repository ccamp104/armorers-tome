{
  "appId": "com.armorerstome.app",
  "appName": "Armorer's Tome",
  "webDir": "www",
  "backgroundColor": "#1e140f",
  "android": {
    "backgroundColor": "#1e140f"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "native",
